# Copy to .env.local, fill locally, and upload through Supabase secrets.
# Never add this filled file or a service role key to GitHub / browser assets.
VISITOR_ALLOWED_ORIGINS=https://gintmr.github.io

# Generate once, e.g. openssl rand -hex 32. Keep stable during a UTC day.
VISITOR_HASH_SECRET=

# Single-value header verified to be overwritten by the trusted hosting proxy.
# Proposed Supabase/Cloudflare header: cf-connecting-ip. Verify on your project
# BEFORE enabling. Leave verification false until the spoofing probe passes.
VISITOR_CLIENT_IP_HEADER=cf-connecting-ip
VISITOR_PROXY_HEADERS_VERIFIED=false

# Optional comma-separated public IPs belonging to the site owner.
# Browser opt-out is more convenient when your own IP changes.
VISITOR_EXCLUDED_IPS=

# No geography by default. After verifying the hosting proxy overwrites country
# headers, set proxy-header to use VISITOR_COUNTRY_HEADER without an external API.
# Alternatively, explicitly set ipinfo + token to enable external IP lookup.
VISITOR_GEO_PROVIDER=none
VISITOR_COUNTRY_HEADER=cf-ipcountry
IPINFO_TOKEN=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the hosted Edge
# runtime automatically. Do not copy those values into the website config.
